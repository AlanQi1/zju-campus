# 浙大校园助手 · 凭据模板
#
# 复制这份文件为 credentials.env，放到插件私有目录：
#   C:\Users\<你>\.dsh\zju-campus\credentials.env
# 或 $DSH_HOME/zju-campus/credentials.env（Linux/macOS）：$HOME/.dsh/zju-campus/credentials.env
#
# 这个文件是明文，不会被插件导出或写进日志；但也不要提交到任何仓库。

# ── 统一身份认证（必填） ─────────────────────────────
# 只在登录那一刻进入内存，密码用学校下发的 RSA 公钥加密后提交。
ZJU_USER=3200100001
ZJU_PASSWORD=your_password

# ── 独立校园系统（可选） ─────────────────────────────
# 大物实验 / 工程训练是另外两套账号，不继承上面统一身份认证的密码。
# 两站都是 HTTP，账号密码明文过校园网；在校外网络下不要打开。
PHYSICS_LAB_USER=
PHYSICS_LAB_PASSWORD=
PHYSICS_LAB_ALLOW_HTTP=false

ENGINEERING_USER=
ENGINEERING_PASSWORD=
ENGINEERING_ALLOW_HTTP=false
